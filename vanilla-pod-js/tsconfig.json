{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.mjs", "generated/**/*.mjs", "web/**/*.mjs", "test/**/*.mjs"]
}
