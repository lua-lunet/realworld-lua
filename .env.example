# PostgreSQL connection (matches `make db-up` by default)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=realworld
PGUSER=postgres
PGPASSWORD=change-me

# Secret used to sign JWT tokens
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection pool cap. Must stay below the server's max_connections
# (PostgreSQL default 100, which also reserves superuser slots).
#PGPOOL_MAX=40
