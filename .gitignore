# Environment variables (all variants may hold credentials, except the example)
.env*
!.env.example

# lunet runtime (fetched by scripts/lunet_fetch_release_v0.9.2.lua / make deps)
.lunet/

# Prebuilt frontend assets (fetched by scripts/frontend.sh / make frontend)
edge/public/

# vanilla-pod-js check gate (npm devDependencies only; zero runtime deps)
vanilla-pod-js/node_modules/

# Self-extracting app bundles (scripts/bundle.sh / make bundle)
dist/

# Runtime files (pid, logs, nginx temp dirs)
target/*
!target/.keep

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
.tmp/
.env
